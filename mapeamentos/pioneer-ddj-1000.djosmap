# Pioneer DDJ-1000 para o DJ OS (formato em docs/mapeamento.md).
# Endereços MIDI tirados do mapeamento do Mixxx para a DDJ-1000 ainda em revisão
# (github.com/mixxxdj/mixxx/pull/17174), de Serhii O. Pashchenko, feito a partir da
# "DDJ-1000 List of MIDI message" da AlphaTheta. Obrigado! (GPL, compatível com o DJ OS.)
# Canais: 1-4 = decks (DECK 1/3 e 2/4 trocam o canal), 5 = BEAT FX, 7 = browser/mixer,
# 8-15 = pads (deck 1, deck 1 + SHIFT, deck 2, deck 2 + SHIFT...), 16 = avisos para a mesa.
# Fone, MASTER LEVEL e BOOTH são analógicos: não mandam MIDI.
# A porta "DDJ-1000" também casa com a DDJ-1000SRT (que não foi conferida).
# Ninguém conferiu com o aparelho ainda: se algo não responder, use CONFIG > CONTROLADORA >
# Registrar os botões e corrija o número aqui.

nome = Pioneer DDJ-1000
porta = DDJ-1000
situacao = em teste
fonte = Mapeamento do Mixxx em revisão (pull request 17174, Pioneer-DDJ-1000.midi.xml e scripts, GPL), feito a partir da List of MIDI message da AlphaTheta

# ---- SHIFT (a mesa também troca as notas sozinha)
nota 1  0x3F  shift
nota 2  0x3F  shift
nota 3  0x3F  shift
nota 4  0x3F  shift

# ---- deck 1
nota 1  0x0B  play             deck=1
nota 1  0x47  stutter          deck=1                # SHIFT + PLAY
nota 1  0x0C  cue              deck=1
nota 1  0x48  inicio           deck=1                # SHIFT + CUE
nota 1  0x58  sync             deck=1                # BEAT SYNC
nota 1  0x5C  pitch_zero       deck=1                # SHIFT + BEAT SYNC (como na DDJ-REV1)
nota 1  0x1A  keylock          deck=1                # MASTER TEMPO
nota 1  0x60  faixa_pitch      deck=1                # SHIFT + MASTER TEMPO = TEMPO RANGE
nota 1  0x40  slip             deck=1                # SLIP
nota 1  0x17  vinil            deck=1                # SHIFT + SLIP = VINYL
nota 1  0x72  deck_ativo       deck=1                # DECK 1/3 ou 2/4
nota 1  0x54  pfl              deck=1                # CUE do fone
nota 1  0x10  loop_in          deck=1
nota 1  0x11  loop_out         deck=1
nota 1  0x12  loop_metade      deck=1                # LOOP IN com loop tocando = 1/2X
nota 1  0x13  loop_dobro       deck=1                # LOOP OUT com loop tocando = 2X
nota 1  0x14  loop             deck=1                # 4 BEAT LOOP / EXIT
nota 1  0x4D  loop_sair        deck=1                # SHIFT + LOOP OUT = RELOOP
nota 1  0x36  jog_toque        deck=1
nota 1  0x67  jog_toque        deck=1                # com SHIFT
cc   1  0x22  jog_scratch      deck=1                # prato (VINYL ligado)
cc   1  0x23  jog_bend         deck=1                # prato (VINYL desligado)
cc   1  0x21  jog_bend         deck=1                # anel de fora
cc   1  0x1F  jog_busca        deck=1                # SHIFT + prato
cc   1  0x26  jog_busca        deck=1                # SHIFT + anel
cc   1  0x29  jog_busca        deck=1                # SEARCH + prato
cc   1  0x13  volume           deck=1 lsb=0x33
cc   1  0x00  tempo            deck=1 lsb=0x20
cc   1  0x04  trim             deck=1 lsb=0x24
cc   1  0x07  agudo            deck=1 lsb=0x27
cc   1  0x0B  medio            deck=1 lsb=0x2B
cc   1  0x0F  grave            deck=1 lsb=0x2F
cc   1  0x05  tempo            deck=1 lsb=0x25       # TEMPO com SHIFT
nota 1  0x1B  pad_modo         deck=1 modo=hotcue    # HOT CUE
nota 1  0x69  pad_modo         deck=1 modo=tracking  # SHIFT + HOT CUE = KEYBOARD (tracking do DJ OS)
nota 1  0x20  pad_modo         deck=1 modo=beatjump  # BEAT JUMP
nota 1  0x6D  pad_modo         deck=1 modo=loop      # SHIFT + BEAT JUMP = BEAT LOOP
nota 1  0x22  pad_modo         deck=1 modo=sampler   # SAMPLER

