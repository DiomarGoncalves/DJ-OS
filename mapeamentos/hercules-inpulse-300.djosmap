nota    8   0x0A  apagar_hotcue deck=2 n=3
nota    8   0x0B  apagar_hotcue deck=2 n=4
nota    8   0x0C  apagar_hotcue deck=2 n=5
nota    8   0x0D  apagar_hotcue deck=2 n=6
nota    8   0x0E  apagar_hotcue deck=2 n=7
nota    8   0x0F  apagar_hotcue deck=2 n=8
# pads: roll e sampler (fazem o que o modo do DJ OS mandar)
nota    8   0x10  pad           deck=2 n=1
nota    8   0x11  pad           deck=2 n=2
nota    8   0x12  pad           deck=2 n=3
nota    8   0x13  pad           deck=2 n=4
