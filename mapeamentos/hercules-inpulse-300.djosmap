nota    8   0x32  pad           deck=2 n=3
nota    8   0x33  pad           deck=2 n=4
nota    8   0x34  pad           deck=2 n=5
nota    8   0x35  pad           deck=2 n=6
nota    8   0x36  pad           deck=2 n=7
nota    8   0x37  pad           deck=2 n=8
# pads: beat jump
nota    8   0x70  beatjump      deck=2 b=-1
nota    8   0x71  beatjump      deck=2 b=1
nota    8   0x72  beatjump      deck=2 b=-2
nota    8   0x73  beatjump      deck=2 b=2
nota    8   0x74  beatjump      deck=2 b=-4
nota    8   0x75  beatjump      deck=2 b=4
nota    8   0x76  beatjump      deck=2 b=-8
nota    8   0x77  beatjump      deck=2 b=8

