# Pioneer CDJ-3000 usado como controladora USB-MIDI.
# Endereços: "CDJ-3000 MIDI Message List" da Pioneer DJ (cdj3000_midi_message_list_e108.pdf).
# Como ligar: cabo USB no computador; no aparelho, escolha o modo de controle por USB-MIDI (veja o manual do CDJ-3000).
# Os botões passam a mandar MIDI (lista oficial da Pioneer).
#
# Um CDJ é um deck só. O canal MIDI sai da configuração do aparelho: no UTILITY, [MIDI CHANNEL] (conferir no manual).
# Aqui: canal 1 = deck 1 e canal 2 = deck 2 (ponha o CDJ no canal 2 para ele ser o deck 2).
# Hoje o DJ OS lê uma porta MIDI por vez: com dois CDJs iguais no USB, só o primeiro é lido.
# Para outro deck, copie o arquivo para ~/DJOS/mapeamentos/ e troque o "nome =" e o deck=.
#
# A lista da Pioneer é só do aparelho para o computador: não há LEDs para acender.
# Jog: o aparelho manda a velocidade do prato (64 parado, 65+ para frente, 63- para trás);
# aqui ela entra como os jogs relativos da Pioneer (relativo64). Pode precisar de ajuste.
# Pitch: 7 bits (0 a 127), menos preciso que nas controladoras de 14 bits.
# O nome da porta "cdj-3000" também pega o CDJ-3000X (lista dele não conferida).

nome = Pioneer CDJ-3000
porta = cdj-3000
situacao = em teste
fonte = "CDJ-3000 MIDI Message List" da Pioneer DJ (cdj3000_midi_message_list_e108.pdf)

# ---------------------------------------------------------------- canal 1 = deck 1
nota  1   0x00  play           deck=1                # PLAY/PAUSE
nota  1   0x01  cue            deck=1                # CUE
nota  1   0x05  inicio         deck=1                # TRACK SEARCH PREV: volta ao começo
nota  1   0x17  jog_toque      deck=1                # JOG TOUCH (encostou em cima do prato)
cc    1   0x10  jog_scratch    deck=1                # JOG (TOUCH): prato com a mão em cima
cc    1   0x30  jog_bend       deck=1                # JOG RING: lateral do prato
cc    1   0x1D  tempo          deck=1                # TEMPO (7 bits: 0 no -, 127 no +)
nota  1   0x09  pitch_zero     deck=1                # TEMPO RESET
nota  1   0x0A  faixa_pitch    deck=1                # TEMPO RANGE
nota  1   0x0B  keylock        deck=1                # MT (MASTER TEMPO)
nota  1   0x0C  vinil          deck=1                # JOG MODE (VINYL/CDJ)
nota  1   0x16  sync           deck=1                # SYNC
nota  1   0x07  slip           deck=1                # SLIP
nota  1   0x1B  hotcue         deck=1 n=1            # HOT CUE A
nota  1   0x1C  hotcue         deck=1 n=2            # HOT CUE B
nota  1   0x1D  hotcue         deck=1 n=3            # HOT CUE C
nota  1   0x1E  hotcue         deck=1 n=4            # HOT CUE D
nota  1   0x1F  hotcue         deck=1 n=5            # HOT CUE E
nota  1   0x20  hotcue         deck=1 n=6            # HOT CUE F
nota  1   0x21  hotcue         deck=1 n=7            # HOT CUE G
nota  1   0x22  hotcue         deck=1 n=8            # HOT CUE H
nota  1   0x23  loop_in        deck=1                # LOOP IN
nota  1   0x24  loop_out       deck=1                # LOOP OUT
nota  1   0x25  loop_sair      deck=1                # RELOOP/EXIT
nota  1   0x0F  loop_metade    deck=1                # CUE/LOOP CALL < : loop pela metade
nota  1   0x0E  loop_dobro     deck=1                # CUE/LOOP CALL > : loop em dobro
nota  1   0x26  loop_auto      deck=1 b=1/16         # BEAT LOOP 1/16 (tela)
nota  1   0x27  loop_auto      deck=1 b=1/8          # BEAT LOOP 1/8 (tela)
nota  1   0x28  loop_auto      deck=1 b=1/4          # BEAT LOOP 1/4 (tela)
nota  1   0x29  loop_auto      deck=1 b=1/2          # BEAT LOOP 1/2 (tela)
nota  1   0x2A  loop_auto      deck=1 b=1            # BEAT LOOP 1 (tela)
nota  1   0x2B  loop_auto      deck=1 b=2            # BEAT LOOP 2 (tela)
nota  1   0x2C  loop_auto      deck=1 b=4            # botão 4 BEAT LOOP
nota  1   0x2D  loop_auto      deck=1 b=8            # botão 8 BEAT LOOP
nota  1   0x2E  loop_auto      deck=1 b=16           # BEAT LOOP 16 (tela)
nota  1   0x2F  loop_auto      deck=1 b=32           # BEAT LOOP 32 (tela)
nota  1   0x30  loop_auto      deck=1 b=1/3          # BEAT LOOP 1/3 (tela)
nota  1   0x31  loop_auto      deck=1 b=3/4          # BEAT LOOP 3/4 (tela)
nota  1   0x32  loop_auto      deck=1 b=3            # BEAT LOOP 3 (tela)
nota  1   0x33  loop_auto      deck=1 b=6            # BEAT LOOP 6 (tela)
nota  1   0x34  loop_auto      deck=1 b=9            # BEAT LOOP 9 (tela)
nota  1   0x4C  loop_auto      deck=1 b=3/2          # BEAT LOOP 3/2 (tela)
nota  1   0x4D  loop_auto      deck=1 b=5            # BEAT LOOP 5 (tela)
nota  1   0x4E  loop_auto      deck=1 b=7            # BEAT LOOP 7 (tela)
nota  1   0x36  beatjump       deck=1 b=16           # 16 BEAT JUMP >
nota  1   0x37  beatjump       deck=1 b=-16          # 16 BEAT JUMP <
nota  1   0x38  beatjump       deck=1 b=1/2          # BEAT JUMP > 1/2 (tela)
nota  1   0x39  beatjump       deck=1 b=-1/2         # BEAT JUMP < 1/2 (tela)
nota  1   0x3A  beatjump       deck=1 b=1            # BEAT JUMP > 1 (tela)
nota  1   0x3B  beatjump       deck=1 b=-1           # BEAT JUMP < 1 (tela)
nota  1   0x3C  beatjump       deck=1 b=2            # BEAT JUMP > 2 (tela)
nota  1   0x3D  beatjump       deck=1 b=-2           # BEAT JUMP < 2 (tela)
nota  1   0x3E  beatjump       deck=1 b=4            # BEAT JUMP > 4 (tela)
nota  1   0x3F  beatjump       deck=1 b=-4           # BEAT JUMP < 4 (tela)
nota  1   0x40  beatjump       deck=1 b=8            # BEAT JUMP > 8 (tela)
nota  1   0x41  beatjump       deck=1 b=-8           # BEAT JUMP < 8 (tela)
nota  1   0x42  beatjump       deck=1 b=16           # BEAT JUMP > 16 (tela)
nota  1   0x43  beatjump       deck=1 b=-16          # BEAT JUMP < 16 (tela)
nota  1   0x44  beatjump       deck=1 b=32           # BEAT JUMP > 32 (tela)
nota  1   0x45  beatjump       deck=1 b=-32          # BEAT JUMP < 32 (tela)
nota  1   0x46  beatjump       deck=1 b=64           # BEAT JUMP > 64 (tela)
nota  1   0x47  beatjump       deck=1 b=-64          # BEAT JUMP < 64 (tela)
cc    1   0x4F  browse_gira                          # seletor girado
nota  1   0x11  load           deck=1                # seletor apertado: carrega (pasta: abre)
nota  1   0x12  browse_aperta                        # BACK: pastas/músicas (segurar: pesquisa)

# ---------------------------------------------------------------- canal 2 = deck 2
nota  2   0x00  play           deck=2                # PLAY/PAUSE
nota  2   0x01  cue            deck=2                # CUE
nota  2   0x05  inicio         deck=2                # TRACK SEARCH PREV: volta ao começo
nota  2   0x17  jog_toque      deck=2                # JOG TOUCH (encostou em cima do prato)
