nota    5   0x0B  apagar_hotcue deck=4 n=4
nota    5   0x04  loop_auto     deck=4 b=1
nota    5   0x05  loop_auto     deck=4 b=2
nota    5   0x06  loop_auto     deck=4 b=4
nota    5   0x07  loop_auto     deck=4 b=8
nota    5   0x0D  loop_metade   deck=4      # SHIFT + pad 6
nota    5   0x0E  loop_dobro    deck=4      # SHIFT + pad 7
nota    5   0x0F  loop_sair     deck=4      # SHIFT + pad 8

# ---------------------------------------------------------------- LEDs (hot cue: 0x55, como no Mixxx)
led nota 2  0x20  sync     deck=1
led nota 2  0x22  cue      deck=1
led nota 2  0x23  tocando  deck=1
led nota 2  0x52  pfl      deck=1
led nota 2  0x00  hotcue   deck=1 n=1 ligado=0x55
led nota 2  0x01  hotcue   deck=1 n=2 ligado=0x55
led nota 2  0x02  hotcue   deck=1 n=3 ligado=0x55
led nota 2  0x03  hotcue   deck=1 n=4 ligado=0x55
