nota  4   0x0B  loop_dobro     deck=4                # CUE/LOOP CALL > : loop em dobro
nota  4   0x51  load           deck=4                # LOAD
cc    4   0x66  deck_ativo     deck=4                # troca de deck (1/3, 2/4) - conferir
