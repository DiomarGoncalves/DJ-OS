nota  6   0x0F  apagar_hotcue  deck=1 n=8            # SHIFT + HOT CUE pad 8: apaga
nota  6   0x10  loop_auto      deck=1 b=1/4          # BEAT LOOP pad 1
nota  6   0x11  loop_auto      deck=1 b=1/2          # BEAT LOOP pad 2
nota  6   0x12  loop_auto      deck=1 b=1            # BEAT LOOP pad 3
