# Pioneer XDJ-XZ (all-in-one, 2 lados que viram 4 decks) usado como controladora USB-MIDI.
# Endereços: "XDJ-XZ MIDI Message List" da Pioneer DJ (xdj-xz_midi_message_list_e3.pdf).
#
# Como ligar: cabo USB no computador; no aparelho, [BROWSE] > [MIDI] > [LOAD] (como diz a
# lista da Pioneer).
#
# Canais: decks 1 a 4 = canais 1 a 4 (o browser também usa o canal 1); mixer e efeitos =
# canal 5; pads dos decks 1 a 4 = canais 6 a 9; LEDs do jog e LOAD = canal 12 (não usados).
# O próprio aparelho resolve o SHIFT: com SHIFT os botões mandam outras notas.
# Os pads mandam notas diferentes em cada modo (HOT CUE, BEAT LOOP, SLIP LOOP, BEAT JUMP);
# os botões de modo também trocam o modo dos pads no DJ OS (o SLIP LOOP vira o roll).
# Jog: contagem relativa com o meio em 64 (65+ horário, 63- anti-horário).
# Pitch: 14 bits (CC 0x00 grosso + CC 0x20 fino).
# Efeitos (BEAT FX / SOUND COLOR FX) não estão mapeados: são do mixer, não de um deck;
# o knob COLOR de cada canal faz o filtro do DJ OS.
# Mixer: o mixer do XZ também mixa de verdade o som que entra nele. Se o EQ ou o volume
# ficarem aplicados duas vezes (no XZ e no DJ OS), apague as linhas do mixer abaixo.
# O XZ tem TEMPO RESET e 4 BEAT. LEDs dos pads: 1 a 127 = número da cor (127 aqui).
# O CH CUE do XZ não acende pelo computador (a lista não tem saída para ele).

nome = Pioneer XDJ-XZ
porta = xdj-xz
situacao = em teste
fonte = "XDJ-XZ MIDI Message List" da Pioneer DJ (xdj-xz_midi_message_list_e3.pdf)

# ---------------------------------------------------------------- browser (canal 1)
cc    1   0x4F  browse_gira                          # ROTARY SELECTOR girado
cc    1   0x60  browse_gira                          # idem, com SHIFT
nota  1   0x33  browse_aperta                        # ROTARY SELECTOR apertado
nota  1   0x32  browser                              # BACK: abre/fecha o browser

# ---------------------------------------------------------------- mixer (canal 5)
cc    5   0x0B  crossfader                           # CROSSFADER
cc    5   0x18  master                               # MASTER LEVEL
cc    5   0x1A  fone_volume                          # HEADPHONES LEVEL
cc    5   0x1B  fone_mix                             # HEADPHONES MIXING (CUE <-> MASTER)
cc    5   0x11  volume         deck=1                # CH FADER 1
cc    5   0x01  trim           deck=1                # TRIM 1
cc    5   0x02  agudo          deck=1                # EQ HI 1
cc    5   0x03  medio          deck=1                # EQ MID 1
cc    5   0x04  grave          deck=1                # EQ LOW 1
cc    5   0x05  filtro         deck=1                # COLOR 1: filtro
cc    5   0x46  pfl            deck=1                # CUE do fone 1
cc    5   0x12  volume         deck=2                # CH FADER 2
cc    5   0x06  trim           deck=2                # TRIM 2
cc    5   0x07  agudo          deck=2                # EQ HI 2
cc    5   0x08  medio          deck=2                # EQ MID 2
cc    5   0x09  grave          deck=2                # EQ LOW 2
cc    5   0x0A  filtro         deck=2                # COLOR 2: filtro
cc    5   0x47  pfl            deck=2                # CUE do fone 2
cc    5   0x13  volume         deck=3                # CH FADER 3
cc    5   0x0C  trim           deck=3                # TRIM 3
cc    5   0x0E  agudo          deck=3                # EQ HI 3
cc    5   0x0F  medio          deck=3                # EQ MID 3
cc    5   0x15  grave          deck=3                # EQ LOW 3
cc    5   0x16  filtro         deck=3                # COLOR 3: filtro
cc    5   0x48  pfl            deck=3                # CUE do fone 3
cc    5   0x14  volume         deck=4                # CH FADER 4
cc    5   0x50  trim           deck=4                # TRIM 4
cc    5   0x51  agudo          deck=4                # EQ HI 4
cc    5   0x5C  medio          deck=4                # EQ MID 4
cc    5   0x52  grave          deck=4                # EQ LOW 4
cc    5   0x53  filtro         deck=4                # COLOR 4: filtro
cc    5   0x49  pfl            deck=4                # CUE do fone 4

# ---------------------------------------------------------------- deck 1 (canal 1)
nota  1   0x00  play           deck=1                # PLAY/PAUSE
nota  1   0x01  cue            deck=1                # CUE
nota  1   0x05  inicio         deck=1                # TRACK SEARCH REV: volta ao começo
nota  1   0x20  jog_toque      deck=1                # encostou em cima do jog
nota  1   0x48  jog_toque      deck=1                # idem, com SHIFT
cc    1   0x22  jog_scratch    deck=1                # jog: prato (contagem, meio 64)
cc    1   0x21  jog_bend       deck=1                # jog: lateral
cc    1   0x29  jog_busca      deck=1                # SHIFT + prato: busca rápida
cc    1   0x26  jog_busca      deck=1                # SHIFT + lateral: busca rápida
cc    1   0x00  tempo          deck=1 lsb=0x20       # TEMPO 14 bits (0 no -, 16383 no +)
nota  1   0x13  pitch_zero     deck=1                # TEMPO RESET
nota  1   0x10  faixa_pitch    deck=1                # TEMPO RANGE
nota  1   0x11  keylock        deck=1                # MASTER TEMPO
nota  1   0x12  vinil          deck=1                # JOG MODE (VINYL/CDJ)
nota  1   0x1F  sync           deck=1                # SYNC
nota  1   0x2C  slip           deck=1                # SLIP
nota  1   0x06  loop_in        deck=1                # LOOP IN
nota  1   0x43  loop_auto      deck=1 b=4            # 4 BEAT
nota  1   0x07  loop_out       deck=1                # LOOP OUT
nota  1   0x08  loop_sair      deck=1                # RELOOP/EXIT
nota  1   0x0C  loop_metade    deck=1                # CUE/LOOP CALL < : loop pela metade
nota  1   0x0B  loop_dobro     deck=1                # CUE/LOOP CALL > : loop em dobro
nota  1   0x51  load           deck=1                # LOAD
cc    1   0x66  deck_ativo     deck=1                # troca de deck (1/3, 2/4) - conferir
nota  1   0x22  pad_modo       deck=1 modo=hotcue    # modo HOT CUE
nota  1   0x23  pad_modo       deck=1 modo=loop      # modo BEAT LOOP
nota  1   0x24  pad_modo       deck=1 modo=roll      # modo SLIP LOOP
nota  1   0x25  pad_modo       deck=1 modo=beatjump  # modo BEAT JUMP
# pads do deck 1 (canal 6): cada modo manda notas diferentes
nota  6   0x00  hotcue         deck=1 n=1            # HOT CUE pad 1
