nota  6   0x04  hotcue         deck=1 n=5            # HOT CUE pad 5
nota  6   0x05  hotcue         deck=1 n=6            # HOT CUE pad 6
nota  6   0x06  hotcue         deck=1 n=7            # HOT CUE pad 7
nota  6   0x07  hotcue         deck=1 n=8            # HOT CUE pad 8
nota  6   0x08  apagar_hotcue  deck=1 n=1            # SHIFT + HOT CUE pad 1: apaga
nota  6   0x09  apagar_hotcue  deck=1 n=2            # SHIFT + HOT CUE pad 2: apaga
nota  6   0x0A  apagar_hotcue  deck=1 n=3            # SHIFT + HOT CUE pad 3: apaga
