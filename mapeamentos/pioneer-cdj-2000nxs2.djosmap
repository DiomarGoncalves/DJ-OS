# Pioneer CDJ-2000NXS2 usado como controladora USB-MIDI.
# Endereços: "List of MIDI Messages" do manual de instruções do CDJ-2000NXS2 (Pioneer DJ).
# Como ligar: cabo USB no computador; no aparelho, aperte [BROWSE/SEARCH] e depois [LINK] > [CONTROL MODE] > [USB-MIDI].
# Os botões passam a mandar MIDI (lista oficial da Pioneer).
#
# Um CDJ é um deck só. O canal MIDI sai da configuração do aparelho: segure [MENU/UTILITY] 1 s > [MIDI CHANNEL] (1 a 16).
# Aqui: canal 1 = deck 1 e canal 2 = deck 2 (ponha o CDJ no canal 2 para ele ser o deck 2).
# Hoje o DJ OS lê uma porta MIDI por vez: com dois CDJs iguais no USB, só o primeiro é lido.
# Para outro deck, copie o arquivo para ~/DJOS/mapeamentos/ e troque o "nome =" e o deck=.
#
# A lista da Pioneer é só do aparelho para o computador: não há LEDs para acender.
# Jog: o aparelho manda a velocidade do prato (64 parado, 65+ para frente, 63- para trás);
# aqui ela entra como os jogs relativos da Pioneer (relativo64). Pode precisar de ajuste.
# Pitch: 7 bits (0 a 127), menos preciso que nas controladoras de 14 bits.
# BEAT JUMP < > da tela: o aparelho não diz quantas batidas; aqui pula 4 (troque b=).

nome = Pioneer CDJ-2000NXS2
porta = cdj-2000nxs2
situacao = em teste
fonte = "List of MIDI Messages" do manual de instruções do CDJ-2000NXS2 (Pioneer DJ)

# ---------------------------------------------------------------- canal 1 = deck 1
nota  1   0x00  play           deck=1                # PLAY/PAUSE
nota  1   0x01  cue            deck=1                # CUE
nota  1   0x05  inicio         deck=1                # TRACK SEARCH << : volta ao começo
nota  1   0x20  jog_toque      deck=1                # JOG TOUCH (encostou em cima do prato)
cc    1   0x10  jog_scratch    deck=1                # JOG (TOUCH): prato com a mão em cima
cc    1   0x30  jog_bend       deck=1                # JOG RING: lateral do prato
cc    1   0x1D  tempo          deck=1                # TEMPO (7 bits: 0 no -, 127 no +)
nota  1   0x0F  pitch_zero     deck=1                # TEMPO RESET
nota  1   0x10  faixa_pitch    deck=1                # TEMPO RANGE
nota  1   0x11  keylock        deck=1                # MASTER TEMPO
nota  1   0x12  vinil          deck=1                # JOG MODE (VINYL/CDJ)
nota  1   0x1F  sync           deck=1                # SYNC
nota  1   0x3A  slip           deck=1                # SLIP
nota  1   0x18  hotcue         deck=1 n=1            # HOT CUE A
nota  1   0x19  hotcue         deck=1 n=2            # HOT CUE B
nota  1   0x1A  hotcue         deck=1 n=3            # HOT CUE C
nota  1   0x1B  hotcue         deck=1 n=4            # HOT CUE D
nota  1   0x14  hotcue         deck=1 n=5            # HOT CUE E
nota  1   0x15  hotcue         deck=1 n=6            # HOT CUE F
nota  1   0x16  hotcue         deck=1 n=7            # HOT CUE G
nota  1   0x17  hotcue         deck=1 n=8            # HOT CUE H
nota  1   0x06  loop_in        deck=1                # LOOP IN
nota  1   0x07  loop_out       deck=1                # LOOP OUT
nota  1   0x08  loop_sair      deck=1                # RELOOP/EXIT
nota  1   0x0C  loop_metade    deck=1                # CUE/LOOP CALL < : loop pela metade
nota  1   0x0B  loop_dobro     deck=1                # CUE/LOOP CALL > : loop em dobro
nota  1   0x24  loop_auto      deck=1 b=1/16         # BEAT LOOP 1/16 (tela)
nota  1   0x25  loop_auto      deck=1 b=1/8          # BEAT LOOP 1/8 (tela)
nota  1   0x26  loop_auto      deck=1 b=1/4          # BEAT LOOP 1/4 (tela)
nota  1   0x27  loop_auto      deck=1 b=1/2          # BEAT LOOP 1/2 (tela)
nota  1   0x28  loop_auto      deck=1 b=1            # BEAT LOOP 1 (tela)
nota  1   0x29  loop_auto      deck=1 b=2            # BEAT LOOP 2 (tela)
nota  1   0x2A  loop_auto      deck=1 b=4            # botão 4 BEAT LOOP
nota  1   0x2B  loop_auto      deck=1 b=8            # BEAT LOOP 8 (tela)
nota  1   0x2C  loop_auto      deck=1 b=16           # BEAT LOOP 16 (tela)
nota  1   0x2D  loop_auto      deck=1 b=32           # BEAT LOOP 32 (tela)
nota  1   0x22  loop_auto      deck=1 b=1/3          # BEAT LOOP 1/3 (tela)
nota  1   0x23  loop_auto      deck=1 b=3/4          # BEAT LOOP 3/4 (tela)
nota  1   0x38  beatjump       deck=1 b=4            # BEAT JUMP > (tela; troque b=)
nota  1   0x39  beatjump       deck=1 b=-4           # BEAT JUMP < (tela; troque b=)
cc    1   0x4F  browse_gira                          # seletor girado
nota  1   0x33  load           deck=1                # seletor apertado: carrega (pasta: abre)
nota  1   0x32  browse_aperta                        # BACK: pastas/músicas (segurar: pesquisa)

# ---------------------------------------------------------------- canal 2 = deck 2
nota  2   0x00  play           deck=2                # PLAY/PAUSE
nota  2   0x01  cue            deck=2                # CUE
nota  2   0x05  inicio         deck=2                # TRACK SEARCH << : volta ao começo
nota  2   0x20  jog_toque      deck=2                # JOG TOUCH (encostou em cima do prato)
cc    2   0x10  jog_scratch    deck=2                # JOG (TOUCH): prato com a mão em cima
cc    2   0x30  jog_bend       deck=2                # JOG RING: lateral do prato
cc    2   0x1D  tempo          deck=2                # TEMPO (7 bits: 0 no -, 127 no +)
nota  2   0x0F  pitch_zero     deck=2                # TEMPO RESET
nota  2   0x10  faixa_pitch    deck=2                # TEMPO RANGE
nota  2   0x11  keylock        deck=2                # MASTER TEMPO
nota  2   0x12  vinil          deck=2                # JOG MODE (VINYL/CDJ)
nota  2   0x1F  sync           deck=2                # SYNC
nota  2   0x3A  slip           deck=2                # SLIP
nota  2   0x18  hotcue         deck=2 n=1            # HOT CUE A
nota  2   0x19  hotcue         deck=2 n=2            # HOT CUE B
nota  2   0x1A  hotcue         deck=2 n=3            # HOT CUE C
nota  2   0x1B  hotcue         deck=2 n=4            # HOT CUE D
nota  2   0x14  hotcue         deck=2 n=5            # HOT CUE E
nota  2   0x15  hotcue         deck=2 n=6            # HOT CUE F
nota  2   0x16  hotcue         deck=2 n=7            # HOT CUE G
nota  2   0x17  hotcue         deck=2 n=8            # HOT CUE H
nota  2   0x06  loop_in        deck=2                # LOOP IN
nota  2   0x07  loop_out       deck=2                # LOOP OUT
nota  2   0x08  loop_sair      deck=2                # RELOOP/EXIT
nota  2   0x0C  loop_metade    deck=2                # CUE/LOOP CALL < : loop pela metade
nota  2   0x0B  loop_dobro     deck=2                # CUE/LOOP CALL > : loop em dobro
nota  2   0x24  loop_auto      deck=2 b=1/16         # BEAT LOOP 1/16 (tela)
nota  2   0x25  loop_auto      deck=2 b=1/8          # BEAT LOOP 1/8 (tela)
nota  2   0x26  loop_auto      deck=2 b=1/4          # BEAT LOOP 1/4 (tela)
nota  2   0x27  loop_auto      deck=2 b=1/2          # BEAT LOOP 1/2 (tela)
nota  2   0x28  loop_auto      deck=2 b=1            # BEAT LOOP 1 (tela)
nota  2   0x29  loop_auto      deck=2 b=2            # BEAT LOOP 2 (tela)
nota  2   0x2A  loop_auto      deck=2 b=4            # botão 4 BEAT LOOP
nota  2   0x2B  loop_auto      deck=2 b=8            # BEAT LOOP 8 (tela)
nota  2   0x2C  loop_auto      deck=2 b=16           # BEAT LOOP 16 (tela)
nota  2   0x2D  loop_auto      deck=2 b=32           # BEAT LOOP 32 (tela)
nota  2   0x22  loop_auto      deck=2 b=1/3          # BEAT LOOP 1/3 (tela)
nota  2   0x23  loop_auto      deck=2 b=3/4          # BEAT LOOP 3/4 (tela)
nota  2   0x38  beatjump       deck=2 b=4            # BEAT JUMP > (tela; troque b=)
nota  2   0x39  beatjump       deck=2 b=-4           # BEAT JUMP < (tela; troque b=)
cc    2   0x4F  browse_gira                          # seletor girado
nota  2   0x33  load           deck=2                # seletor apertado: carrega (pasta: abre)
nota  2   0x32  browse_aperta                        # BACK: pastas/músicas (segurar: pesquisa)
