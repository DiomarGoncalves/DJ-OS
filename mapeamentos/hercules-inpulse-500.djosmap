nota    7   0x55  pad           deck=1 n=6
nota    7   0x56  pad           deck=1 n=7
nota    7   0x57  pad           deck=1 n=8
# pads: beat jump (com SHIFT, 16 a 128)
nota    7   0x70  beatjump      deck=1 b=-1
nota    7   0x71  beatjump      deck=1 b=1
nota    7   0x72  beatjump      deck=1 b=-2
nota    7   0x73  beatjump      deck=1 b=2
nota    7   0x74  beatjump      deck=1 b=-4
nota    7   0x75  beatjump      deck=1 b=4
nota    7   0x76  beatjump      deck=1 b=-8
nota    7   0x77  beatjump      deck=1 b=8
nota    7   0x78  beatjump      deck=1 b=-16
nota    7   0x79  beatjump      deck=1 b=16
nota    7   0x7A  beatjump      deck=1 b=-32
nota    7   0x7B  beatjump      deck=1 b=32
nota    7   0x7C  beatjump      deck=1 b=-64
nota    7   0x7D  beatjump      deck=1 b=64
nota    7   0x7E  beatjump      deck=1 b=-128
nota    7   0x7F  beatjump      deck=1 b=128

# ---------------------------------------------------------------- deck 2 (canal 3; com SHIFT canal 6; pads canal 8)
nota    3   0x07  play          deck=2
nota    6   0x07  stutter       deck=2
