# Pioneer DDJ-SB3 para o DJ OS (formato em docs/mapeamento.md).
# Endereços MIDI tirados do mapeamento do Mixxx (Pioneer-DDJ-SB3.midi.xml), de Dancephy.com,
# Be, Michael Stahl (DG3NEC), Joan Ardiaca Jové, wingcom e Hilton Rudham. Obrigado!
# (GPL-2.0 ou posterior, compatível com o DJ OS.)
# Canais: 1-4 = decks (DECK 3/4 troca o canal), 5 = FX1 (esquerda), 6 = FX2 (direita),
# 7 = browser/mixer, 8-11 = pads dos decks 1-4 (com SHIFT a nota soma 8).
# Ninguém conferiu com o aparelho ainda: se algo não responder, use CONFIG > CONTROLADORA >
# Registrar os botões e corrija o número aqui.

nome = Pioneer DDJ-SB3
porta = DDJ-SB3
situacao = em teste
fonte = Mapeamento do Mixxx (Pioneer-DDJ-SB3.midi.xml e scripts, GPL-2.0+)

# ---- SHIFT
nota 1  0x3F  shift
nota 2  0x3F  shift
nota 3  0x3F  shift
nota 4  0x3F  shift

# ---- deck 1
nota 1  0x0B  play             deck=1
nota 1  0x47  stutter          deck=1                # SHIFT + PLAY
nota 1  0x0C  cue              deck=1
nota 1  0x48  inicio           deck=1                # SHIFT + CUE
nota 1  0x58  sync             deck=1
nota 1  0x5C  pitch_zero       deck=1                # SHIFT + SYNC (como na DDJ-REV1)
nota 1  0x1A  keylock          deck=1
nota 1  0x60  faixa_pitch      deck=1                # SHIFT + KEY LOCK
nota 1  0x17  vinil            deck=1                # VINYL
nota 1  0x40  slip             deck=1                # SHIFT + VINYL
nota 1  0x72  deck_ativo       deck=1                # DECK 1
nota 1  0x54  pfl              deck=1                # CUE do fone
nota 1  0x68  pfl              deck=3                # SHIFT + CUE: fone do deck 3
nota 1  0x14  loop             deck=1                # AUTO LOOP
nota 1  0x50  loop_sair        deck=1                # SHIFT + AUTO LOOP
nota 1  0x12  loop_metade      deck=1                # 1/2X
nota 1  0x13  loop_dobro       deck=1                # 2X
nota 1  0x61  loop_in          deck=1                # SHIFT + 1/2X
nota 1  0x62  loop_out         deck=1                # SHIFT + 2X
nota 1  0x36  jog_toque        deck=1                # modo vinil
nota 1  0x67  jog_toque        deck=1                # com SHIFT
cc   1  0x22  jog_scratch      deck=1                # prato (modo vinil)
cc   1  0x23  jog_bend         deck=1                # prato (vinil desligado)
cc   1  0x21  jog_bend         deck=1                # lateral do jog
cc   1  0x1F  jog_busca        deck=1                # SHIFT + prato
cc   1  0x26  jog_busca        deck=1                # SHIFT + lateral
cc   1  0x13  volume           deck=1 lsb=0x33
cc   1  0x00  tempo            deck=1 lsb=0x20
cc   1  0x04  trim             deck=1 lsb=0x24
cc   1  0x07  agudo            deck=1 lsb=0x27
cc   1  0x0B  medio            deck=1 lsb=0x2B
cc   1  0x0F  grave            deck=1 lsb=0x2F
cc   1  0x05  tempo            deck=1 lsb=0x25       # TEMPO com SHIFT
nota 1  0x1B  pad_modo         deck=1 modo=hotcue    # HOT CUE
nota 1  0x69  pad_modo         deck=1 modo=beatjump  # SHIFT + HOT CUE = BEAT JUMP
nota 1  0x6B  pad_modo         deck=1 modo=roll      # SHIFT + FX FADE = ROLL
nota 1  0x22  pad_modo         deck=1 modo=sampler   # SAMPLER

