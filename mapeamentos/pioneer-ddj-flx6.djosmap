# ---- mixer e browser (canal 7)
cc   7  0x17  filtro           deck=1 lsb=0x37       # CH1 FILTER
cc   7  0x18  filtro           deck=2 lsb=0x38       # CH2 FILTER
cc   7  0x19  filtro           deck=3 lsb=0x39       # CH3 FILTER
cc   7  0x1A  filtro           deck=4 lsb=0x3A       # CH4 FILTER
cc   7  0x1F  crossfader       lsb=0x3F
cc   7  0x0C  fone_mix         lsb=0x2C              # HEADPHONES MIXING
cc   7  0x40  browse_gira
nota 7  0x41  browse_aperta
nota 7  0x42  browser                                # SHIFT + BROWSE: lista em tela cheia
nota 7  0x46  load             deck=1
nota 7  0x47  load             deck=2
nota 7  0x48  load             deck=3
nota 7  0x49  load             deck=4

# ---- BEAT FX esquerdo (canal 5) -> deck 1; botões como na DDJ-REV1
nota 5  0x47  fx_liga          deck=1                # ON/OFF (a nota muda com o FX 1/2/3 aceso)
nota 5  0x48  fx_liga          deck=1
nota 5  0x49  fx_liga          deck=1
nota 5  0x70  fx_proximo       deck=1                # FX 1: troca o efeito
nota 5  0x63  fx_proximo       deck=1                # FX 1 com SHIFT
nota 5  0x71  fx_batida_menos  deck=1                # FX 2
nota 5  0x06  fx_batida_menos  deck=1                # FX 2 com SHIFT
nota 5  0x72  fx_batida_mais   deck=1                # FX 3
nota 5  0x07  fx_batida_mais   deck=1                # FX 3 com SHIFT
cc   5  0x02  fx_nivel         deck=1 lsb=0x22       # LEVEL/DEPTH (o CC muda com o FX aceso)
cc   5  0x04  fx_nivel         deck=1 lsb=0x24
cc   5  0x06  fx_nivel         deck=1 lsb=0x26

# ---- BEAT FX direito (canal 6) -> deck 2; botões como na DDJ-REV1
nota 6  0x47  fx_liga          deck=2                # ON/OFF (a nota muda com o FX 1/2/3 aceso)
nota 6  0x48  fx_liga          deck=2
nota 6  0x49  fx_liga          deck=2
nota 6  0x70  fx_proximo       deck=2                # FX 1: troca o efeito
nota 6  0x71  fx_batida_menos  deck=2                # FX 2
nota 6  0x06  fx_batida_menos  deck=2                # FX 2 com SHIFT
nota 6  0x72  fx_batida_mais   deck=2                # FX 3
nota 6  0x07  fx_batida_mais   deck=2                # FX 3 com SHIFT
cc   6  0x02  fx_nivel         deck=2 lsb=0x22       # LEVEL/DEPTH (o CC muda com o FX aceso)
cc   6  0x04  fx_nivel         deck=2 lsb=0x24
cc   6  0x06  fx_nivel         deck=2 lsb=0x26

