# Pioneer DDJ-FLX6 para o DJ OS (formato em docs/mapeamento.md).
# Endereços MIDI tirados do mapeamento comunitário do Mixxx para a DDJ-FLX6
# (github.com/fixxiefixx/DDJ-FLX6-Mixxx-mapping; autores: Warker, nschloe, dj3730, jusko,
# Robert904, jaimearu, fixxJ), adaptado do Pioneer-DDJ-FLX4 do Mixxx (GPL-2.0+). Obrigado!
# Não é o mapeamento oficial do Mixxx: confira com cuidado.
# Canais: 1-4 = decks, 5 = FX esquerdo, 6 = FX direito, 7 = browser/mixer,
# 8-15 = pads (deck 1, deck 1 + SHIFT, deck 2, deck 2 + SHIFT...).
# Ninguém conferiu com o aparelho ainda: se algo não responder, use CONFIG > CONTROLADORA >
# Registrar os botões e corrija o número aqui.

nome = Pioneer DDJ-FLX6
porta = DDJ-FLX6
situacao = em teste
fonte = Mapeamento do Mixxx da comunidade (github.com/fixxiefixx/DDJ-FLX6-Mixxx-mapping, derivado do Pioneer-DDJ-FLX4 do Mixxx, GPL)

# ---- SHIFT
nota 1  0x3F  shift
nota 2  0x3F  shift
nota 3  0x3F  shift
nota 4  0x3F  shift

# ---- deck 1
nota 1  0x0B  play             deck=1
nota 1  0x47  stutter          deck=1                # SHIFT + PLAY
nota 1  0x0C  cue              deck=1
nota 1  0x48  inicio           deck=1                # SHIFT + CUE
nota 1  0x58  sync             deck=1
nota 1  0x60  faixa_pitch      deck=1                # SHIFT + MASTER TEMPO
nota 1  0x3D  slip             deck=1                # MEMORY (como no mapeamento de origem)
nota 1  0x3E  keylock          deck=1                # SHIFT + MEMORY
nota 1  0x3C  deck_ativo       deck=1                # DECK (avisa o deck daquele lado)
nota 1  0x54  pfl              deck=1                # CUE do fone
nota 1  0x10  loop_in          deck=1
nota 1  0x11  loop_out         deck=1
nota 1  0x4D  loop_sair        deck=1                # RELOOP/EXIT
nota 1  0x51  loop_metade      deck=1                # CUE/LOOP CALL <
nota 1  0x53  loop_dobro       deck=1                # CUE/LOOP CALL >
nota 1  0x36  jog_toque        deck=1
nota 1  0x67  jog_toque        deck=1                # com SHIFT
cc   1  0x22  jog_scratch      deck=1                # prato (modo vinil)
cc   1  0x23  jog_bend         deck=1                # prato (vinil desligado)
cc   1  0x21  jog_bend         deck=1                # lateral do jog
cc   1  0x29  jog_busca        deck=1                # SHIFT + jog
cc   1  0x13  volume           deck=1 lsb=0x33
cc   1  0x00  tempo            deck=1 lsb=0x20
cc   1  0x04  trim             deck=1 lsb=0x24
cc   1  0x07  agudo            deck=1 lsb=0x27
cc   1  0x0B  medio            deck=1 lsb=0x2B
cc   1  0x0F  grave            deck=1 lsb=0x2F
nota 1  0x1B  pad_modo         deck=1 modo=hotcue    # HOT CUE
nota 1  0x69  pad_modo         deck=1 modo=tracking  # SHIFT + HOT CUE = KEYBOARD
nota 1  0x20  pad_modo         deck=1 modo=beatjump  # BEAT JUMP
nota 1  0x6D  pad_modo         deck=1 modo=loop      # SHIFT + BEAT JUMP = BEAT LOOP
nota 1  0x22  pad_modo         deck=1 modo=sampler   # SAMPLER

