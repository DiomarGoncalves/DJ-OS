#!/bin/sh
# Anota no registro do sistema, a cada 15 s, a temperatura (°C), o uso do processador, a memória
# e a bateria/tomada: se o aparelho desligar sozinho, dá para ver se foi calor (o registro fica no
# disco e vai para o pendrive pela opção "copiar registros" do menu da ISO).
while true; do
    t=""
    # Sensores sem leitura (ou que dão erro) ficam de fora.
    for z in /sys/class/thermal/thermal_zone*; do
        v=$(cat "$z/temp" 2>/dev/null)
        case "$v" in ''|*[!0-9-]*) continue ;; esac
        t="$t $(cat "$z/type" 2>/dev/null)=$((v / 1000))"
    done
    for h in /sys/class/hwmon/hwmon*; do
        [ "$(cat "$h/name" 2>/dev/null)" = coretemp ] || continue
        for f in "$h"/temp*_input; do
            v=$(cat "$f" 2>/dev/null)
            case "$v" in ''|*[!0-9-]*) continue ;; esac
            t="$t core=$((v / 1000))"
        done
    done
    energia=""
    for p in /sys/class/power_supply/*; do
        case "$(cat "$p/type" 2>/dev/null)" in
            Mains) energia="$energia tomada=$(cat "$p/online" 2>/dev/null)" ;;
            Battery) energia="$energia bateria=$(cat "$p/capacity" 2>/dev/null)%($(cat "$p/status" 2>/dev/null))" ;;
        esac
    done
    mem=$(awk '/MemAvailable/ {printf "%d", $2/1024}' /proc/meminfo)
    # Velocidade: o limite do controle de calor e a frequência atual do primeiro núcleo (MHz).
    vel=""
    [ -r /sys/devices/system/cpu/intel_pstate/max_perf_pct ] && vel=" limite=$(cat /sys/devices/system/cpu/intel_pstate/max_perf_pct)%"
    f=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq 2>/dev/null) && vel="$vel $((f / 1000))MHz"
    linha="temperatura:${t:- ?} | carga $(cut -d' ' -f1-3 /proc/loadavg) |${vel:- velocidade ?} | memória livre ${mem} MB |${energia:- energia ?}"
    echo "$linha"
    # Também num arquivo na parte DADOS, gravado no disco na hora (sobrevive a um corte de energia).
    if [ -d /dados/sistema ]; then
        arq=/dados/sistema/temperatura.log
        [ "$(stat -c %s "$arq" 2>/dev/null || echo 0)" -gt 2000000 ] && mv -f "$arq" "$arq.1"
        echo "$(date '+%Y-%m-%d %H:%M:%S') $linha" >>"$arq"
        sync "$arq"
    fi
    sleep 15
done
