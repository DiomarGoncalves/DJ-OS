#!/bin/bash
# Instalador do DJ OS: apaga o disco escolhido e instala o sistema.
#
# Roda na tela 1 quando a ISO liga pela opção "INSTALAR NO DISCO" (djos.instalar no boot).
# Para testes automáticos: djos.instalar=auto:<disco> (ex.: auto:vda) instala sem perguntar.
#
# Disco instalado (GPT, liga em BIOS antiga e em UEFI):
#   1  bios      1 MB    código do GRUB para BIOS antiga
#   2  DJOS_BOOT  256 MB  FAT32: GRUB (BIOS e UEFI) e a memória de qual versão ligar
#   3  DJOS_SISTEMA 6 GB  ext4: a/ e b/, duas versões do sistema (somente leitura)
#   4  DJOS_DADOS resto   ext4: músicas, configurações, pareamentos
set -u
LOG=/run/dj-os-instalar.log
MEDIO=/run/live/medium
TITULO="DJ OS $(cat /etc/dj-os-versao 2>/dev/null) - instalador"
export NEWT_COLORS='root=,black window=,black border=yellow,black title=yellow,black textbox=white,black button=black,yellow actbutton=black,yellow listbox=white,black actlistbox=black,yellow actsellistbox=black,yellow'

auto=$(sed -n 's/.*djos\.instalar=auto:\([a-z0-9]*\).*/\1/p' /proc/cmdline)
# Botões em português em todas as telas.
wt() { whiptail --title "$TITULO" --yes-button "Sim" --no-button "Não" --ok-button "OK" --cancel-button "Cancelar" "$@"; }
msg() { [ -n "$auto" ] && { echo "$1"; return; }; wt --msgbox "$1" 14 70; }

# Guarda o registro num pendrive (pasta dj-os-registros), para abrir depois no PC. Pula o disco
# que estava recebendo o sistema.
. /usr/local/lib/dj-os/pendrive.sh
salvar_registro() {
    local copia="/run/instalar-$(date +%Y%m%d-%H%M%S).log"
    cp "$LOG" "$copia"
    no_pendrive "$copia" dj-os-registros "${alvo:-}"
}

# Junta no registro o que ajuda a entender o erro (discos, montagens, mensagens do kernel).
detalhes() {
    {
        echo "== discos"; lsblk -o NAME,SIZE,TYPE,FSTYPE,LABEL,TRAN,MODEL,MOUNTPOINTS
        echo "== montagens"; findmnt -r -o TARGET,SOURCE,FSTYPE,OPTIONS | grep -v -e cgroup -e /proc -e /sys
        echo "== boot"; cat /proc/cmdline
        echo "== kernel (últimas mensagens)"; dmesg | tail -n 60
    } >>"$LOG" 2>&1
}

erro() {
    echo "ERRO: $1" | tee -a "$LOG"
    detalhes
    if [ -n "$auto" ]; then reboot; exit 1; fi
    salvar_registro
    if [ -n "$salvos" ]; then onde="O registro do erro foi salvo em:$salvos"
    else onde="Não achei pendrive que aceite gravação para salvar o registro.\nColoque outro pendrive e escolha 'Salvar o registro' no menu."; fi
    wt --msgbox "Não deu certo:\n\n$1\n\n$onde\n\nNada além do disco escolhido foi mexido." 18 74
    while true; do
        o=$(wt --nocancel --menu "O que fazer agora?" 16 74 5 \
            1 "Ver o registro na tela (dá para tirar foto)" \
            2 "Salvar o registro num pendrive" \
            3 "Tentar instalar de novo" \
            4 "Desligar" \
            5 "Reiniciar" 3>&1 1>&2 2>&3) || o=1
        case $o in
        1) tail -n 200 "$LOG" >/run/dj-os-registro.txt; wt --scrolltext --textbox /run/dj-os-registro.txt 24 78 ;;
        2) salvar_registro
           if [ -n "$salvos" ]; then wt --msgbox "Salvo em:$salvos" 12 74; else wt --msgbox "Nenhum pendrive aceitou. Coloque outro (FAT32, exFAT ou NTFS) e tente de novo." 10 74; fi ;;
        3) exec "$0" ;;
        4) clear; poweroff; exit 1 ;;
        5) clear; reboot; exit 1 ;;
        esac
    done
}
passo() { echo "$1" >>"$LOG"; echo "$1" >/run/dj-os-passo; [ -n "$auto" ] && echo "$1" || echo "XXX
$2
$1
XXX"; }

clear
[ -f "$MEDIO/live/filesystem.squashfs" ] || erro "Não achei o sistema na ISO ($MEDIO/live)."

# Disco(s) de onde a ISO ligou: não podem ser escolhidos. Segue a cadeia até o disco físico
# (pelo Ventoy a origem é /dev/mapper/ventoy, que fica em cima do pendrive).
src=$(findmnt -n -o SOURCE "$MEDIO")
origem=" $(lsblk -s -n -r -o NAME,TYPE "$src" 2>/dev/null | awk '$2=="disk"{printf "%s ", $1}')"
for f in $(findmnt -n -o SOURCE /run/live/rootfs/* 2>/dev/null); do
    origem="$origem$(lsblk -s -n -r -o NAME,TYPE "$f" 2>/dev/null | awk '$2=="disk"{printf "%s ", $1}')"
done
echo "origem da ISO: $src ->$origem" >>"$LOG"
# Discos que podem receber o sistema (o pendrive da ISO não), com pelo menos 12 GB.
discos=()
for nome in $(lsblk -dn -r -o NAME,TYPE | awk '$2=="disk"{print $1}'); do
    case "$origem" in *" $nome "*) continue ;; esac
    case "$nome" in loop*|sr*|zram*|fd*) continue ;; esac
    bytes=$(lsblk -bdn -o SIZE "/dev/$nome")
    [ "$bytes" -ge $((12 * 1024 * 1024 * 1024)) ] || continue
    tamanho=$(lsblk -dn -o SIZE "/dev/$nome" | tr -d ' ')
    [ "$(lsblk -dn -o TRAN "/dev/$nome" | tr -d ' ')" = usb ] && onde="USB" || onde="interno"
    modelo=$(lsblk -dn -o MODEL "/dev/$nome" | sed 's/ *$//')
    discos+=("$nome" "$tamanho  $onde  ${modelo:-disco}")
done

if [ -n "$auto" ]; then
    alvo=$auto
    case "$origem" in *" $alvo "*) erro "O disco $alvo é o da própria ISO." ;; esac
else
    wt --yesno "Este assistente instala o DJ OS no computador.\n\nO disco escolhido será APAGADO INTEIRO: tudo o que estiver nele (Windows, arquivos) será perdido.\n\nContinuar?" 14 70 || { clear; reboot; exit 0; }
    [ ${#discos[@]} -gt 0 ] || erro "Nenhum disco de pelo menos 12 GB encontrado (o pendrive da ISO não conta)."
    alvo=$(wt --menu "Em qual disco instalar?\n(setas para escolher, Enter para confirmar)" 16 70 6 "${discos[@]}" 3>&1 1>&2 2>&3) || { clear; reboot; exit 0; }
    info=$(lsblk -dn -o SIZE,MODEL "/dev/$alvo")
    wt --defaultno --yesno "ÚLTIMA CONFIRMAÇÃO\n\nApagar TUDO em /dev/$alvo ($info)\ne instalar o DJ OS?" 12 70 || { clear; reboot; exit 0; }
fi
D=/dev/$alvo
[ -b "$D" ] || erro "Disco $D não existe."
case "$alvo" in nvme*|mmcblk*) P=${D}p ;; *) P=$D ;; esac

instalar() {
    set -e
    # Se algum comando falhar, o registro diz qual foi.
    trap 'echo "FALHOU (linha $LINENO, código $?): $BASH_COMMAND" >>"$LOG"' ERR
    # A ISO no pendrive pode ter chegado estragada (cópia interrompida): confere antes de apagar
    # qualquer coisa.
    passo "Conferindo a ISO no pendrive" 2
    if [ -f "$MEDIO/live/SHA256SUMS" ] && ! (cd "$MEDIO/live" && sha256sum --quiet -c SHA256SUMS >>"$LOG" 2>&1); then
        echo "ISO ESTRAGADA" >>"$LOG"
        exit 3
    fi
    passo "Apagando o disco $D" 5
    umount "$P"* 2>/dev/null || true
    wipefs -a "$D" >>"$LOG" 2>&1
    sgdisk -Z "$D" >>"$LOG" 2>&1
    passo "Criando as partes do disco" 10
    sgdisk -n 1:0:+1M -t 1:EF02 -c 1:bios \
           -n 2:0:+256M -t 2:EF00 -c 2:DJOS_BOOT \
           -n 3:0:+6G -t 3:8300 -c 3:DJOS_SISTEMA \
           -n 4:0:0 -t 4:8300 -c 4:DJOS_DADOS "$D" >>"$LOG" 2>&1
    partprobe "$D" 2>/dev/null || true
    udevadm settle
    sleep 1
    mkfs.fat -F 32 -n DJOS_BOOT "${P}2" >>"$LOG" 2>&1
    mkfs.ext4 -q -F -L DJOS_SISTEMA "${P}3" >>"$LOG" 2>&1
    mkfs.ext4 -q -F -L DJOS_DADOS -m 1 "${P}4" >>"$LOG" 2>&1
    mkdir -p /mnt/boot /mnt/sistema /mnt/dados
    mount "${P}2" /mnt/boot
    mount "${P}3" /mnt/sistema
    mount "${P}4" /mnt/dados

    passo "Copiando o sistema (versão A)" 20
    mkdir -p /mnt/sistema/a
    cp "$MEDIO/live/vmlinuz" "$MEDIO/live/initrd.img" /mnt/sistema/a/
    passo "Copiando o sistema (pode levar alguns minutos)" 30
    cp "$MEDIO/live/filesystem.squashfs" /mnt/sistema/a/
    cat /etc/dj-os-versao > /mnt/sistema/a/versao
    sync
    passo "Conferindo o que foi gravado no disco" 75
    # Lê de volta do disco de verdade: sem limpar a memória, a conferência leria a cópia que ainda
    # está na RAM, e um disco com defeito (aceita a gravação e devolve outra coisa) passaria.
    sync
    echo 3 > /proc/sys/vm/drop_caches
    if [ -f "$MEDIO/live/SHA256SUMS" ]; then
        (cd /mnt/sistema/a && sha256sum -c "$MEDIO/live/SHA256SUMS") >>"$LOG" 2>&1 || { echo "CÓPIA ESTRAGADA" >>"$LOG"; exit 4; }
        # Para o boot conferir o kernel se não conseguir ligar (mostra na tela o que estragou).
        grep -v filesystem.squashfs "$MEDIO/live/SHA256SUMS" > /mnt/sistema/a/boot.sha256
    fi
    dmesg | grep -i -e "i/o error" -e "ata.*error" -e "nvme.*error" -e "mmc.*error" | tail -n 20 >>"$LOG"

    passo "Instalando o carregador (BIOS e UEFI)" 80
    grub-install --target=i386-pc --boot-directory=/mnt/boot/boot "$D" >>"$LOG" 2>&1
    grub-install --target=x86_64-efi --efi-directory=/mnt/boot --boot-directory=/mnt/boot/boot \
        --removable --no-nvram >>"$LOG" 2>&1
    cp /usr/share/dj-os/grub-instalado.cfg /mnt/boot/boot/grub/grub.cfg
    grub-editenv /mnt/boot/boot/grub/grubenv create
    grub-editenv /mnt/boot/boot/grub/grubenv set ativo=a boot_ok=1

    passo "Preparando a parte das músicas" 95
    mkdir -p /mnt/dados/dj/musicas
    chown -R 1000:1000 /mnt/dados/dj
    sync
    umount /mnt/boot /mnt/sistema /mnt/dados
    passo "Pronto" 100
}

echo "== instalando em $D ($(date))" >>"$LOG"
if [ -n "$auto" ]; then
    ( instalar ); rc=$?
else
    ( instalar ) 2>>"$LOG" | wt --gauge "Preparando…" 8 70 0
    rc=${PIPESTATUS[0]}
fi
case $rc in
    0) ;;
    3) erro "A ISO no pendrive está estragada (a cópia não chegou inteira).\nNada foi apagado. Copie a ISO de novo para o pendrive e use 'Remover com segurança' antes de tirar." ;;
    4) erro "O disco interno gravou o sistema ERRADO: escrevemos uma coisa e, lendo de volta,\nveio outra. Sinal de disco com defeito.\nTente de novo; se repetir, o disco precisa ser trocado." ;;
    *) erro "A instalação parou no passo:\n  $(cat /run/dj-os-passo 2>/dev/null)\n$(grep '^FALHOU' "$LOG" | tail -n 1)" ;;
esac
# Outro disco com um DJ OS antigo: o computador pode continuar ligando por ele (e ele pode estar
# estragado). Oferece desativar: apaga só o boot e o sistema antigos; as músicas daquele disco ficam.
if [ -z "$auto" ]; then
    for d in $(lsblk -dn -r -o NAME,TYPE | awk '$2=="disk"{print $1}'); do
        [ "$d" = "$alvo" ] && continue
        case "$origem" in *" $d "*) continue ;; esac
        lsblk -nr -o LABEL "/dev/$d" | grep -qx -e DJOS_BOOT -e DJOS_SISTEMA || continue
        info=$(lsblk -dn -o SIZE,MODEL "/dev/$d" | sed 's/ *$//')
        echo "DJ OS antigo em $d ($info)" >>"$LOG"
        wt --yesno "Achei OUTRO DJ OS instalado no disco $d ($info).\n\nO computador pode continuar ligando por ele em vez do novo.\n\nDesativar o DJ OS antigo desse disco?\n(apaga só o boot e o sistema antigos; as músicas desse disco ficam)" 16 74 || continue
        for p in $(lsblk -nr -o PATH,LABEL "/dev/$d" | awk '$2=="DJOS_BOOT" || $2=="DJOS_SISTEMA" {print $1}'); do
            umount "$p" 2>/dev/null
            wipefs -a "$p" >>"$LOG" 2>&1
        done
        # Código de boot da BIOS antiga (os primeiros 440 bytes); a tabela de partições fica.
        dd if=/dev/zero of="/dev/$d" bs=440 count=1 conv=notrunc 2>>"$LOG"
        sync
        echo "DJ OS antigo em $d desativado" >>"$LOG"
    done
fi
# Desliga em vez de reiniciar: o sistema da instalação roda do pendrive, então o pendrive só pode
# sair com o computador desligado (tirar antes dá aquelas mensagens de erro no desligamento).
msg "Instalação concluída!\n\nAperte Enter: o computador vai DESLIGAR.\nCom ele desligado, tire o pendrive e ligue de novo: já abre o DJ OS."
[ -n "$auto" ] && { echo "INSTALADO"; poweroff; exit 0; }
clear
poweroff
