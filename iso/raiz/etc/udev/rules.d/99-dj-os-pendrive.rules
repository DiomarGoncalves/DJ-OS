# Pendrive ou SSD USB com sistema de arquivos: monta para o DJ OS (exceto a própria ISO).
# SUBSYSTEMS=="usb" (algum pai no USB) e não ID_BUS: HD/SSD em case USB vem com ID_BUS=ata
# (o udev lê o disco de dentro da case), só pendrive vem com ID_BUS=usb.
# A partição de boot (EFI) de um disco com sistema instalado fica de fora.
ACTION=="add", SUBSYSTEM=="block", SUBSYSTEMS=="usb", ENV{ID_FS_USAGE}=="filesystem", ENV{ID_FS_TYPE}!="iso9660", ENV{ID_PART_ENTRY_TYPE}!="c12a7328-f81f-11d2-ba4b-00a0c93ec93b", RUN+="/usr/local/bin/dj-os-montar $devnode '%E{ID_FS_LABEL}' '%E{ID_FS_UUID}' '%E{ID_FS_TYPE}'"
