# Pendrive ou SSD USB com sistema de arquivos: monta para o DJ OS (exceto a própria ISO).
ACTION=="add", SUBSYSTEM=="block", ENV{ID_BUS}=="usb", ENV{ID_FS_USAGE}=="filesystem", ENV{ID_FS_TYPE}!="iso9660", RUN+="/usr/local/bin/dj-os-montar $devnode '%E{ID_FS_LABEL}' '%E{ID_FS_UUID}' '%E{ID_FS_TYPE}'"
